<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".application.TodoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TODOApplication"
        tools:targetApi="31">
        <activity
            android:name=".multipleviewtype.MultipleViewTypeColumnActivity"
            android:exported="false"
            android:label="@string/title_activity_multiple_view_type_column"
            android:theme="@style/Theme.TODOApplication" />
        <activity
            android:name=".movies.MoviesActivity"
            android:exported="false"
            android:label="@string/title_activity_movies"
            android:theme="@style/Theme.TODOApplication" />
        <activity
            android:name=".todo.TodosActivity"
            android:exported="false"
            android:label="@string/title_activity_todos"
            android:theme="@style/Theme.TODOApplication" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TODOApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>